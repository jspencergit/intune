# PlatformIO / Teensy
.pio/
.pioenvs/
.piolibdeps/
.vscode/
*.hex
*.elf
*.o
*.a

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
env/

# Old project folders (temporary - to ignore until cleaned up)
intune-visualizer/
intune_teensy/
output.txt

# Audio reference files (large media - do not commit)
*.mp3
*.wav
*.flac
reference_audio/
test_audio/

# Generated analysis output
visualizer/plots/

# Raylib / CMake C++ visualizer (build artifacts)
visualizer_raylib/build/
visualizer_raylib/dist/
visualizer_raylib/*.exe
visualizer_raylib/*.pdb

# ESP32 / PlatformIO (esp32/ — root .pio/ above also applies)
esp32/.pio/

# Android / Gradle (see also android/.gitignore)
android/.gradle/
android/.idea/
android/.kotlin/
android/local.properties
android/**/build/
android/**/*.apk
android/**/*.aab
android/captures/
android/.externalNativeBuild/
android/.cxx/

# iOS / Xcode (see also ios/.gitignore)
ios/**/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/**/build/
ios/**/.swiftpm/

# Cursor / agent tooling (local only — not project source)
mcps/
terminals/

# Teensy pitch test harness — machine-local / generated outputs
teensy/tools/audio_device.txt
teensy/tools/*_results.json
teensy/tools/*_summary.txt
teensy/tools/last_suite_results.json
teensy/tools/_live_capture/

# Android UI capture (ADB screenshots for agent review)
android/screenshots/**
!android/screenshots/.gitkeep